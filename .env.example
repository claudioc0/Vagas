# =====================================================================
# CONFIGURAÇÕES OPCIONAIS DO RADAR DE VAGAS
# =====================================================================
# Para ativar as notificações no Telegram e o leitor de alertas do LinkedIn:
# 1. Copie este arquivo para ".env":
#    cp .env.example .env (ou renomeie manualmente)
# 2. Preencha os campos abaixo com os seus dados.
# =====================================================================

# --- NOTIFICAÇÃO NO TELEGRAM (Alertas imediatos no celular) ---
# 1. Crie um bot no Telegram falando com o @BotFather (comando /newbot) e cole o token abaixo:
TELEGRAM_BOT_TOKEN=

# 2. Obtenha seu ID numérico falando com o bot @userinfobot no Telegram e cole abaixo:
TELEGRAM_CHAT_ID=


# --- ALERTAS DO LINKEDIN VIA GMAIL (Leitura 100% imune a bloqueios) ---
# O LinkedIn envia e-mails com as vagas das suas buscas salvas (jobalerts-noreply@linkedin.com).
# O script lê esses e-mails por IMAP seguro sem violar os termos de uso do LinkedIn.
# 1. Seu endereço de e-mail do Gmail:
GMAIL_USER=

# 2. Senha de Aplicativo Google (16 caracteres, NÃO é a sua senha normal do e-mail):
# Gere em: https://myaccount.google.com/apppasswords
# (Requer autenticação em duas etapas ativada na sua conta Google)
GMAIL_APP_PASSWORD=
